# 多账号配置 (逗号分隔, 格式: slug:game_name:tag_line:region:label)
# 示例: main:The shy:asdf:KR:The shy#asdf,smurf:은여하:1103:KR:은여하#1103
THESHY_ACCOUNTS=main:The shy:asdf:KR:The shy#asdf,smurf:은여하:1103:KR:은여하#1103

# 默认账号配置 (单账号时生效)
THESHY_RIOT_ID=The shy#asdf
THESHY_REGION=KR

# 推送渠道 (至少填一个)
# Bark (推荐): 手机装 Bark App, 复制推送 URL 末尾的字符串
# 完整 URL 也行: https://api.day.app/<key>
BARK_KEY=

# Server酱: https://sct.ftqq.com/ (免费版每天 5 条上限)
SERVERCHAN_KEY=

# Discord Webhook: 频道设置 → 整合 → Webhook → 新建 → 复制 URL
DISCORD_WEBHOOK=

# 勿扰时段 (可选, 24小时制, 如 23:00-08:00 表示晚上11点到早上8点不发非紧急通知)
QUIET_START=
QUIET_END=
