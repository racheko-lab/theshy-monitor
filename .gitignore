# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/

# Local env (不要把你的真实 key 推到 GitHub!)
.env
.env.local

# 个人配置文件 (使用 config.example.json 作为模板, 复制为 config.json 后修改)
config.json

# Local state (本地运行的状态文件, GitHub Actions 会自己管)
# 注意: 不要忽略 .theshy_*.json, 因为 GitHub Actions 需要它
# 如果本地测试不想 commit, 临时取消下一行注释:
# .theshy_opgg_state.json

# Logs
*.log
nohup.out
